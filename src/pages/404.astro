---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page not found | Wahidul Alam Nahid"
  description="This page doesn't exist. Head back to the homepage or pick one of the sections."
  noindex
>
  <header class="persona-hero" style="--accent: var(--rust);">
    <div class="wrap">
      <span class="kicker" style="color:var(--rust);">Error 404</span>
      <h1>This page isn't here.</h1>
      <p class="lede">The link may be old, or the page may have moved. Try one of these instead.</p>
      <div class="btn-row">
        <a class="btn-primary" href="/">Back to the homepage</a>
        <a class="btn-ghost" href="/qa-engineer">QA Engineer</a>
        <a class="btn-ghost" href="/writer">Writer</a>
        <a class="btn-ghost" href="/artist">Artist</a>
      </div>
    </div>
  </header>
</Layout>
