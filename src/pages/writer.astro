---
import Layout from '../layouts/Layout.astro';
import ExploreMore from '../components/ExploreMore.astro';

const focus = [
  { title: '23 er Diary', body: 'A psychology-related initiative to understand people and what goes on inside them.' },
  { title: 'Poetry', body: 'Poems about love and romance.' },
  { title: 'Short Stories', body: 'Planned next, in the spirit of Avyantar.' },
  { title: 'Travel & Personal Experience', body: 'Reflections on tours and trips, and on moments from my own life.' },
];
---
<Layout
  title="Writer | Wahidul Alam Nahid"
  description="Poems, travel writing, the 23 er Diary and Avyantar, a Bengali psychological novel in nine chapters, by Wahidul Alam Nahid. Written in English and Bengali."
  breadcrumbs={[{ label: 'Writer', href: '/writer' }]}
>

  <header class="persona-hero" style="--accent: var(--mustard);">
    <div class="disc-solo"></div>
    <div class="wrap">
      <span class="kicker" style="color:var(--mustard);">Section 02 · Writer</span>
      <h1>A vault for the things I can't say out loud.</h1>
      <p class="lede">Poems, stories, and reflections in English and Bengali. The place where my unexpressed emotions end up.</p>
    </div>
  </header>

  <section class="persona-body" style="--accent: var(--mustard);">
    <div class="wrap">
      <div class="persona-copy">
        <p>I write to express my thoughts, my inner self, and the stories I build in my head. No other hobby does this for me. Painting and film give a feeling a shape, but writing is where the emotions I haven't expressed anywhere else get to stay.</p>
        <p>I write in both English and Bengali. Some of it is poetry about love and romance. Some of it is personal: what I experienced, and what I saw and felt on my travels and tours. And one part, <em>23 er Diary</em>, is a psychology-related initiative to understand people better.</p>
        <p>Short stories are the next step. I'd like to write them in the spirit of Avyantar, where the reader doesn't just follow the plot but sits inside the character's head.</p>
      </div>
      <div class="focus-grid">
        <span class="kicker" style="color:var(--mustard);">Focus Areas</span>
        {focus.map((f) => (
          <div class="focus-card" style="--accent: var(--mustard);">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap">
      <div class="novel-callout">
        <span class="novel-sub">The Novel</span>
        <div class="novel-cover"><img src="/images/avyantar-cover.jpg" alt="Avyantar: illustration of a man looking out a window at a passing train" /></div>
        <div style="text-align:center;max-width:60ch;margin:0 auto;">
          <h3 lang="bn">অভ্যন্তর <span lang="en" style="font-family:var(--body);font-weight:500;color:var(--ink-soft);">(Avyantar, "Inside")</span></h3>
          <p>A Bengali-language psychological novel in nine chapters. In a crumbling house in Bakultala, a reclusive writer cannot write a single line, and a dead telephone rings every night at 11:50. Then a young reporter arrives for an interview. All nine chapters are published here.</p>
          <p>I want the reader to get deep into the characters and feel the atmosphere and emotion of each chapter.</p>
          <blockquote lang="bn" style="text-align:left;">বকুলতলার এক জীর্ণ বাড়িতে এক নিঃসঙ্গ লেখক একটা লাইনও লিখতে পারেন না। প্রতি রাতে এগারোটা পঞ্চাশে বেজে ওঠে একটা মরা টেলিফোন। তারপর একদিন সাক্ষাৎকার নিতে আসে এক তরুণ সাংবাদিক।</blockquote>
          <a class="btn-ghost" href="/avyantar">Read the novel (Bengali) →</a>
        </div>
      </div>
    </div>
  </section>

  <ExploreMore items={[{ label: 'QA Engineer', href: '/qa-engineer' }, { label: 'Artist', href: '/artist' }, { label: 'Read the blog', href: '/#dispatches' }]} />

  <div class="back-link wrap"><a class="btn-ghost" href="/">← Back home</a></div>

</Layout>
