---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "QA engineer, writer, artist, filmmaker. Wahidul Alam Nahid's portfolio.",
  active = '',
} = Astro.props;

const navItems = [
  { href: '/#about', label: 'The Polymath', key: 'about' },
  { href: '/#expertise', label: 'Expertise', key: 'expertise' },
  { href: '/#dispatches', label: 'Dispatches', key: 'dispatches' },
];

const personaItems = [
  { href: '/qa-engineer', label: 'QA Engineer', key: 'qa-engineer' },
  { href: '/writer', label: 'Writer', key: 'writer' },
  { href: '/artist', label: 'Artist', key: 'artist' },
  { href: '/filmmaker', label: 'Filmmaker', key: 'filmmaker' },
  { href: '/psychology', label: 'Psychology', key: 'psychology' },
  { href: '/collector', label: 'Collector', key: 'collector' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Urbanist:wght@500;600;700;800;900&family=Onest:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body>
  <nav class="site-nav">
    <div class="wrap">
      <a class="logo" href="/">Wahidul Alam Nahid</a>
      <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <ul class="navlinks" id="navlinks">
        <li><a href={navItems[0].href} class={active === navItems[0].key ? 'active' : ''}>{navItems[0].label}</a></li>
        <li><a href={navItems[1].href} class={active === navItems[1].key ? 'active' : ''}>{navItems[1].label}</a></li>
        <li class="has-dropdown">
          <a href="/#work" class="dropdown-toggle" aria-haspopup="true" aria-expanded="false">
            Personas <span class="caret" aria-hidden="true">▾</span>
          </a>
          <ul class="dropdown-menu">
            {personaItems.map((item) => (
              <li><a href={item.href} class={active === item.key ? 'active' : ''}>{item.label}</a></li>
            ))}
          </ul>
        </li>
        <li><a href={navItems[2].href} class={active === navItems[2].key ? 'active' : ''}>{navItems[2].label}</a></li>
        <li><a class="btn" href="/#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <slot />

  <script>
    const toggle = document.querySelector('.nav-toggle');
    const navlinks = document.getElementById('navlinks');
    toggle?.addEventListener('click', () => {
      const isOpen = navlinks?.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });
    navlinks?.querySelectorAll('a:not(.dropdown-toggle)').forEach((a) => {
      a.addEventListener('click', () => {
        navlinks.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });

    document.querySelectorAll('.has-dropdown').forEach((item) => {
      const dropToggle = item.querySelector('.dropdown-toggle');
      dropToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = item.classList.toggle('open');
        dropToggle.setAttribute('aria-expanded', String(isOpen));
      });
    });
    document.addEventListener('click', (e) => {
      document.querySelectorAll('.has-dropdown.open').forEach((item) => {
        if (!item.contains(e.target)) {
          item.classList.remove('open');
          item.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  </script>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <div class="fname">Wahidul Alam Nahid</div>
        <div class="floc">Dhaka, Bangladesh</div>
        <a class="floc footer-email" href="mailto:wahidulalam.nahid@gmail.com">wahidulalam.nahid@gmail.com</a>
        <div class="socials footer-socials">
          <a class="social-linkedin" href="https://www.linkedin.com/in/wahidulnahid/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
          <a class="social-github" href="https://github.com/wahidulalamnahid" target="_blank" rel="noopener" aria-label="GitHub">gh</a>
          <a class="social-fb" href="https://www.facebook.com/wahid222/" target="_blank" rel="noopener" aria-label="Facebook">fb</a>
          <a class="social-ig" href="https://www.instagram.com/being_polymath/" target="_blank" rel="noopener" aria-label="Instagram">ig</a>
          <a class="social-pin" href="https://www.pinterest.com/wahidnahid/" target="_blank" rel="noopener" aria-label="Pinterest">pin</a>
          <a class="social-yt" href="https://www.youtube.com/@PolySpectrumFilms" target="_blank" rel="noopener" aria-label="YouTube">yt</a>
        </div>
      </div>
      <ul class="footlinks">
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <ul class="footlinks">
        {personaItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </footer>
</body>
</html>
